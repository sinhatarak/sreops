.hero {
  text-align: center;
  padding: 4rem 1rem 3rem;
  margin-bottom: 2rem;
  border-radius: 16px;
  background: linear-gradient(135deg, #00897b 0%, #004d40 55%, #ff6d00 140%);
  background-size: 200% 200%;
  animation: shift 12s ease infinite;
  color: #fff;
}
.hero h1 { color: #fff; font-size: 2.6rem; margin: 0 0 .5rem; }
.hero .hero-sub { font-size: 1.15rem; opacity: .9; }
.hero .md-button { margin: .4rem; color: #fff; border-color: #fff; }
.hero .md-button--primary { background: #ff6d00; border-color: #ff6d00; }
.md-typeset .grid.cards > ul > li { transition: transform .2s, box-shadow .2s; }
.md-typeset .grid.cards > ul > li:hover { transform: translateY(-4px); }
@keyframes shift { 0%,100% { background-position: 0 50% } 50% { background-position: 100% 50% } }
@media (prefers-reduced-motion: reduce) { .hero { animation: none; } }

/* header: show only the GitHub icon, hide the repo name text */
.md-header__source .md-source__repository { display: none; }
.md-header__source { width: auto; margin-left: .5rem; }

/* credential strip */
.credstrip {
  display: flex;
  align-items: center;
  gap: 1.5rem;
  padding: 1.25rem 1.5rem;
  margin: 1.5rem 0 2rem;
  border-radius: 12px;
  border: 1px solid var(--md-default-fg-color--lightest);
  border-left: 5px solid var(--md-accent-fg-color);
  background: var(--md-code-bg-color);
}
.credstrip .credstrip-badge { width: 96px; height: auto; flex-shrink: 0; margin: 0; }
.credstrip p { margin: .2rem 0; }
@media (max-width: 600px) {
  .credstrip { flex-direction: column; text-align: center; }
}

/* header: LinkedIn / YouTube icons beside the GitHub icon */
.md-header__social { display: flex; align-items: center; gap: .1rem; margin-left: .25rem; }
.md-header__social-link { display: flex; padding: .45rem; border-radius: 50%; color: inherit; opacity: .9; transition: opacity .2s, transform .2s; }
.md-header__social-link:hover { opacity: 1; transform: translateY(-2px); }
.md-header__social-link svg { width: 1.35rem; height: 1.35rem; fill: currentColor; }
@media (max-width: 59.9375em) { .md-header__social { display: none; } }  /* same breakpoint where Material hides the GitHub button */

/* header + tabs: deep navy to teal gradient, orange active marker */
.md-header {
  background: linear-gradient(90deg, #0b132b 0%, #004d57 55%, #00796b 100%);
  box-shadow: 0 2px 14px rgba(0, 0, 0, .35);
}
.md-tabs {
  background: linear-gradient(90deg, #0b132b 0%, #004d57 55%, #00796b 100%);
  border-top: 1px solid rgba(255, 255, 255, .08);
}
.md-tabs__item { padding-left: .55rem; padding-right: .55rem; }
.md-tabs__link { font-size: .72rem; font-weight: 600; letter-spacing: .2px; opacity: .8; }
.md-tabs__link:hover,
.md-tabs__item--active .md-tabs__link { opacity: 1; }
.md-tabs__item--active { box-shadow: inset 0 -3px 0 #ff6d00; }
.md-header__title { font-weight: 700; }

/* wider layout so 12 tabs fit comfortably */
.md-grid { max-width: 72rem; }

/* ---------- hero (split with terminal) ---------- */
.hero.hero-split {
  display: grid; grid-template-columns: 1.15fr 1fr; gap: 2rem;
  align-items: center; text-align: left; padding: 2.75rem 2.25rem;
  background: linear-gradient(135deg, #0b132b 0%, #004d57 55%, #00796b 100%);
  background-size: 200% 200%; animation: shift 14s ease infinite;
}
.hero-split h1 { font-size: 2.5rem; line-height: 1.15; }
.hero-split h1 strong { color: #ff9e40; }
.hero-roles { font-size: 1.2rem; margin: .25rem 0 1rem; color: #cfeff0; }
.rotator { display: inline-block; height: 1.5em; overflow: hidden; vertical-align: bottom; }
.rotator span { display: block; height: 1.5em; line-height: 1.5em; font-weight: 700; color: #ff9e40; animation: rot 15s ease-in-out infinite; }
@keyframes rot {
  0%,16% { transform: translateY(0) }       20%,36% { transform: translateY(-100%) }
  40%,56% { transform: translateY(-200%) }  60%,76% { transform: translateY(-300%) }
  80%,96% { transform: translateY(-400%) }  100% { transform: translateY(-500%) }
}

/* terminal card */
.terminal { background: #0d1117; border-radius: 12px; box-shadow: 0 18px 40px rgba(0,0,0,.45); overflow: hidden; border: 1px solid rgba(255,255,255,.1); }
.t-bar { display: flex; align-items: center; gap: .4rem; padding: .55rem .8rem; background: #161b22; color: #8b949e; font-size: .7rem; }
.t-bar i { width: .65rem; height: .65rem; border-radius: 50%; background: #ff5f56; display: inline-block; }
.t-bar i:nth-child(2) { background: #ffbd2e; } .t-bar i:nth-child(3) { background: #27c93f; }
.t-bar span { margin-left: .6rem; }
.t-body { padding: .9rem 1rem 1.1rem; font-family: var(--md-code-font-family, monospace); font-size: .72rem; line-height: 1.55; color: #c9d1d9; min-height: 13rem; }
.t-line { color: #7ee787; overflow: hidden; white-space: nowrap; width: 0; animation: type 1.6s steps(var(--n)) var(--d) forwards; }
@keyframes type { to { width: calc(var(--n) * 1ch); } }
.t-out { white-space: pre; opacity: 0; color: #c9d1d9; animation: show .25s ease var(--d) forwards; }
.t-out.ok { color: #7ee787; }
@keyframes show { to { opacity: 1; } }
.t-cursor { color: #7ee787; opacity: 0; animation: show .1s linear 8.6s forwards; }
.t-cursor b { display: inline-block; width: .5ch; height: 1em; background: #7ee787; vertical-align: text-bottom; animation: blink 1s steps(1) infinite; }
@keyframes blink { 50% { opacity: 0; } }

/* stats */
.stats { display: grid; grid-template-columns: repeat(3, 1fr); gap: 1rem; margin: 0 0 1.5rem; }
.stats div { text-align: center; padding: 1rem .5rem; border-radius: 12px; border: 1px solid var(--md-default-fg-color--lightest); background: var(--md-code-bg-color); }
.stats strong { display: block; font-size: 2rem; line-height: 1.1; color: var(--md-accent-fg-color); }
.stats span { font-size: .75rem; opacity: .85; }

/* chips */
.chips { display: flex; flex-wrap: wrap; gap: .5rem; margin: .5rem 0 1.5rem; }
.chip { padding: .3rem .85rem; border-radius: 999px; font-size: .78rem; font-weight: 600; text-decoration: none; border: 1px solid var(--md-default-fg-color--lightest); background: var(--md-code-bg-color); transition: transform .15s, background .15s, color .15s, border-color .15s; }
.chip:hover { transform: translateY(-2px); background: #00796b; border-color: #00796b; color: #fff !important; }

/* topic cards: gradient top edge + lift */
.md-typeset .grid.cards > ul > li {
  background: linear-gradient(90deg, #00897b, #ff6d00) top / 100% 3px no-repeat, var(--md-default-bg-color);
  transition: transform .2s, box-shadow .2s, border-color .2s;
}
.md-typeset .grid.cards > ul > li:hover { transform: translateY(-5px); box-shadow: 0 10px 24px rgba(0,0,0,.18); border-color: var(--md-accent-fg-color); }

/* call to action */
.cta { margin: 2.5rem 0 1rem; padding: 2rem; text-align: center; border-radius: 16px; color: #fff; background: linear-gradient(135deg, #0b132b, #004d57 60%, #00796b); }
.cta h2 { color: #fff; margin-top: 0; }
.cta .md-button { margin: .3rem; color: #fff; border-color: #fff; }
.cta .md-button--primary { background: #ff6d00; border-color: #ff6d00; }

@media (max-width: 60em) {
  .hero.hero-split { grid-template-columns: 1fr; padding: 2rem 1.25rem; }
  .stats { grid-template-columns: 1fr; }
}
@media (prefers-reduced-motion: reduce) {
  .t-line { width: auto; animation: none; } .t-out, .t-cursor { opacity: 1; animation: none; }
  .rotator span, .hero.hero-split { animation: none; }
}
